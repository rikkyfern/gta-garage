# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gta_garage"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
ADMIN_EMAILS="admin@example.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security
SECURITY_RATE_LIMIT_PER_MINUTE="120"
SECURITY_AUTH_RATE_LIMIT_PER_MINUTE="20"
SECURITY_SCAN_BLOCK_THRESHOLD="12"

# Cloudinary (for car photo uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (for emails)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="GTA Garage <noreply@yourdomain.com>"

# Telegram Bot (find-only car search)
TELEGRAM_BOT_TOKEN="123456789:your-telegram-bot-token"
TELEGRAM_WEBHOOK_SECRET="change-me-to-a-random-webhook-secret"
TELEGRAM_BOT_USERNAME="your_gta_garage_bot"
